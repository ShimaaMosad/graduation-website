e,t,r){r.r(t),r.d(t,{_content:()=>g,codeBlock:()=>a,heading:()=>i,inlineCode:()=>s,lexicalHtmlOnly:()=>n,link:()=>u,linkReadOnly:()=>p,listItem:()=>h,listOl:()=>m,listUl:()=>_,paragraph:()=>o,textBold:()=>l,textItalic:()=>d,textStrikethrough:()=>c});let n="lexical_editor_theme--lexicalHtmlOnly--zd9pA",i="lexical_editor_theme--heading--qEuct",a="lexical_editor_theme--codeBlock--Su87p",s="lexical_editor_theme--inlineCode--wyhG6",o="lexical_editor_theme--paragraph--bBN8l",l="lexical_editor_theme--textBold--AcKe3",d="lexical_editor_theme--textItalic--8VSlo",c="lexical_editor_theme--textStrikethrough--6aezK",u="lexical_editor_theme--link--muzLU",p="lexical_editor_theme--linkReadOnly--U6Hvn",m="lexical_editor_theme--listOl--rIHAk",_="lexical_editor_theme--listUl--U67yq",h="lexical_editor_theme--listItem---RbAU",g="/** @postcss-export-raw */\n\n.lexical_editor_theme--lexicalHtmlOnly--zd9pA {\n  -webkit-user-select: text;\n          user-select: text;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n.lexical_editor_theme--heading--qEuct {\n  font-size: 14px;\n  font-weight: bold;\n  margin: 0;\n}\n\n.lexical_editor_theme--codeBlock--Su87p {\n  display: block;\n  background-color: var(--color-bg-secondary);\n  border-radius: 3px;\n  padding: 2px 4px;\n  margin: 0;\n  font-family: 'Roboto Mono';\n  line-height: 1.7;\n  white-space: break-spaces;\n}\n\n.lexical_editor_theme--inlineCode--wyhG6 {\n  background-color: var(--color-bg-secondary);\n  border-radius: 3px;\n  padding: 0px 4px;\n  margin: 0;\n  font-family: 'Roboto Mono';\n  line-height: 1.7;\n}\n\n.lexical_editor_theme--paragraph--bBN8l {\n  margin: 0;\n}\n\n.lexical_editor_theme--textBold--AcKe3 {\n  font-weight: bold;\n}\n\n.lexical_editor_theme--textItalic--8VSlo {\n  font-style: italic;\n}\n\n.lexical_editor_theme--textStrikethrough--6aezK {\n  -webkit-text-decoration: line-through;\n  text-decoration: line-through;\n}\n\n.lexical_editor_theme--link--muzLU,\n.lexical_editor_theme--linkReadOnly--U6Hvn {\n  color: var(--color-text-brand);\n  cursor: pointer;\n  -webkit-text-decoration: none;\n  text-decoration: none;\n}\n\n.lexical_editor_theme--link--muzLU:hover {\n  -webkit-text-decoration: underline;\n  text-decoration: underline;\n}\n\n.lexical_editor_theme--listOl--rIHAk {\n  padding: 0;\n  margin: 0;\n  list-style-position: outside;\n  list-style-type: decimal;\n}\n\n.lexical_editor_theme--listUl--U67yq {\n  padding: 0;\n  margin: 0;\n  list-style-position: outside;\n  list-style-type: disc;\n}\n\n.lexical_editor_theme--listItem---RbAU {\n  margin-left: 20px;\n}\n"},285782(e,t,r){r.d(t,{N:()=>n});let n="/** @postcss-export-raw */\n\n/*\n * Stylesheet for all quill editor related content.\n * Branched off of https://cdn.quilljs.com/1.3.6/quill.snow.css\n */\n\n.text-editor {\n  border: 1px solid var(--color-border);\n  border-radius: 3px;\n}\n\n.text-editor:focus-within {\n    margin: -1px;\n    border: 2px solid var(--color-border-selected);\n  }\n\n/* The where clause allows us to make changes without changing specificity */\n\n[data-fpl-version='ui3'] .text-editor,\n  \n  :where([data-fpl-ui3-override]) .text-editor {\n    border-radius: var(--radius-medium);\n  }\n\n[data-fpl-version='ui3'] .text-editor:focus-within, :where([data-fpl-ui3-override]) .text-editor:focus-within {\n      margin: var(--spacer-0);\n      border-width: 1px;\n    }\n\n.ql-toolbar button {\n    border: 1px solid transparent;\n    outline: none;\n}\n\n.ql-toolbar button:focus-visible {\n    border: 1px solid var(--color-border-selected);\n    outline: 1px solid var(--color-border-selected);\n    outline-offset: -2px;\n  }\n\n.ql-toolbar button:focus {\n    border: 1px solid var(--color-border-selected);\n    outline: 1px solid var(--color-border-selected);\n    outline-offset: -2px;\n  }\n\n.ql-toolbar button:focus:not(:focus-visible) {\n    border: 1px solid transparent;\n    outline: none;\n  }\n\n.ql-container {\n  box-sizing: border-box;\n  font-size: 11px;\n  font-family: Inter, sans-serif;\n  height: 100%;\n  margin: 0px;\n  position: relative;\n  background-color: var(--color-bg, transparent);\n\n  /* The where clause allows us to make changes without changing specificity */\n}\n\n[data-fpl-version='ui3'] .ql-container,\n  \n  :where([data-fpl-ui3-override]) .ql-container {\n    border-radius: var(--radius-medium);\n  }\n\n/* The where clause allows us to make changes without changing specificity */\n\n[data-fpl-version='ui3'] .ql-container:not(.ql-disabled),\n  \n  :where([data-fpl-ui3-override]) .ql-container:not(.ql-disabled) {\n      /* only add secondary background for non read-only editors in ui3 */\n      background-color: var(--color-bg-secondary);\n      min-height: inherit;\n  }\n\n.ql-clipboard {\n  left: -100000px;\n  height: 1px;\n  overflow-y: hidden;\n  position: absolute;\n  top: 50%;\n}\n\n.ql-hidden {\n  display: none;\n}\n\n/**\n * Editor styling\n */\n\n.ql-editor {\n  box-sizing: border-box;\n  line-height: 1.7;\n  height: 100%;\n  outline: none;\n  overflow-y: auto;\n  padding: 6px;\n  tab-size: 4;\n  -moz-tab-size: 4;\n  text-align: left;\n  white-space: pre-wrap;\n  word-wrap: break-word;\n  max-height: 304px;\n\n  /* The where clause allows us to make changes without changing specificity */\n}\n\n[data-fpl-version='ui3'] .ql-editor,\n  \n  :where([data-fpl-ui3-override]) .ql-editor {\n    padding: calc(var(--spacer-1) - 1px) calc(var(--spacer-2) - 1px);\n  }\n\n/*\n * Styling for rendering the placeholder text. We differ from quill's styling\n * of the placeholder text so that we can support placeholders with multiple\n * lines without overflowing the editor.\n * See https://github.com/quilljs/quill/issues/2413 for more details.\n */\n\n.ql-editor.ql-blank::after {\n  color: var(--color-text-tertiary);\n  content: attr(data-placeholder);\n  pointer-events: none;\n  display: block;\n  /* Match editor line-height */\n  margin-top: -1.7em;\n}\n\n:not(.quill_editor--quill-readonly--aJLWF) > .quill_editor--ql-editor--gaOc- {\n  min-height: 80px;\n}\n\n.ql-editor > * {\n  cursor: text;\n}\n\n.ql-editor p,\n.ql-editor ol,\n.ql-editor ul,\n.ql-editor pre,\n.ql-editor blockquote,\n.ql-editor h1,\n.ql-editor h2 {\n  color: var(--color-text);\n  margin: 0;\n  padding: 0;\n  counter-reset: list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9;\n}\n\n.ql-editor strong {\n  font-weight: bold;\n}\n\n.ql-editor h1 {\n  font-size: 18px;\n  font-weight: bold;\n}\n\n.ql-editor h2 {\n  font-size: 14px;\n  font-weight: bold;\n}\n\n.ql-editor em {\n  font-style: italic;\n}\n\n.ql-editor s {\n  -webkit-text-decoration: line-through;\n  text-decoration: line-through;\n}\n\n.ql-editor a {\n  color: var(--color-text-brand);\n  cursor: pointer;\n}\n\n.ql-editor a:hover {\n    -webkit-text-decoration: underline;\n    text-decoration: underline;\n  }\n\n.ql-editor a:focus {\n    border: 1px solid transparent;\n    outline: none;\n  }\n\n.ql-editor a:focus:focus-visible {\n    border: 1px solid var(--color-border-selected);\n    outline: 1px solid var(--color-border-selected);\n    outline-offset: -2px;\n  }\n\n.ql-editor a:focus:focus {\n    border: 1px solid var(--color-border-selected);\n    outline: 1px solid var(--color-border-selected);\n    outline-offset: -2px;\n  }\n\n.ql-editor a:focus:focus:not(:focus-visible) {\n    border: 1px solid transparent;\n    outline: none;\n  }\n\n.ql-editor ol,\n.ql-editor ul {\n  padding-left: 2em;\n  list-style-type: none;\n}\n\n.ql-editor ul > li::before {\n  content: '\\2022';\n}\n\n.ql-editor li::before {\n  display: inline-block;\n  white-space: nowrap;\n  width: 1.2em;\n}\n\n.ql-editor li:not(.ql-direction-rtl)::before {\n  margin-left: -1.5em;\n  margin-right: 0.3em;\n  text-align: right;\n}\n\n.ql-editor ol li[data-list='ordered'] {\n  counter-increment: list-0;\n}\n\n.ql-editor ol li[data-list='ordered']::before {\n  content: counter(list-0, decimal) '. ';\n}\n\n.ql-editor ol > li[data-list='bullet']::before {\n  content: '\\2022';\n}\n\n.ql-editor code,\n.ql-editor .ql-code-block {\n  background-color: var(--color-bg-secondary);\n  border-radius: 3px;\n  font-family: 'Roboto Mono';\n}\n\n.ql-editor .ql-code-block {\n  padding: 2px 4px;\n  white-space: break-spaces;\n}\n\n.ql-editor code {\n  padding: 0px 4px;\n}\n\n/**\n * Readonly editor styling\n */\n\n.quill-readonly .ql-editor {\n  padding: 0px;\n  font-size: 14px;\n  min-height: none !important;\n  max-height: none;\n}\n\n.quill-readonly .ql-editor h1 {\n  font-size: 24px;\n}\n\n.quill-readonly .ql-editor h2 {\n  font-size: 18px;\n}\n\n/**\n * Toolbar styling\n */\n\n.ql-toolbar {\n  padding-left: 4px;\n  border-top: 1px solid var(--color-border);\n  bottom: 0;\n  background: var(--color-bg);\n\n  /* The where clause allows us to make changes without changing specificity */\n}\n\n[data-fpl-version='ui3'] .ql-toolbar,\n  \n  :where([data-fpl-ui3-override]) .ql-toolbar {\n    border-radius: var(--spacer-0) var(--spacer-0) var(--radius-medium) var(--radius-medium);\n  }\n\n.ql-toolbar button {\n  background: none;\n  display: inline-block;\n  height: 26px;\n  width: 26px;\n  margin: 4px 1px;\n  box-sizing: border-box;\n  border-radius: 3px;\n}\n\n.ql-toolbar button:hover {\n    background: var(--color-bg-hover);\n  }\n\n.ql-toolbar button.ql-active {\n    background: var(--color-bg-selected);\n  }\n\n.ql-toolbar svg {\n  float: none;\n  margin: 0 auto;\n}\n\n.ql-toolbar button path {\n  fill: var(--color-icon);\n}\n\n.ql-toolbar button.disabled {\n  background: none;\n}\n\n.ql-toolbar button.disabled:hover {\n    background: none;\n  }\n\n.ql-toolbar button.disabled path {\n  fill: var(--color-icon-disabled);\n}\n\n/*\n * Tooltip styling\n */\n\n.ql-tooltip {\n  position: absolute;\n  transform: translateY(10px);\n  /* stylelint-disable-next-line @fpl/no-manual-z-index */\n  z-index: 1;\n  background-color: var(--color-bg-tooltip);\n  border: 1px solid var(--color-border-tooltip);\n  box-shadow: 0px 4px 14px var(--color-border-tooltip);\n  color: var(--color-text-tooltip);\n  white-space: nowrap;\n  border-radius: 3px;\n}\n\n.ql-tooltip.ql-editing input[type='text'] {\n  background-color: var(--color-bg-tooltip, transparent);\n  display: inline-block;\n  font-size: 12px;\n  color: var(--color-text-tooltip);\n  height: 28px;\n  margin: 0px;\n  width: 170px;\n  padding: 0px 12px;\n  border-radius: 3px;\n}\n\n.ql-tooltip a.ql-preview {\n  display: inline-block;\n  overflow-x: hidden;\n  text-overflow: ellipsis;\n  vertical-align: top;\n  padding-left: 12px;\n  width: 170px;\n  padding: 7px 12px;\n  color: var(--color-text-tooltip);\n}\n\n.ql-tooltip a.ql-action {\n  padding: 7px 0px;\n  width: 54px;\n  border-left: 1px solid var(--color-border-tooltip);\n  display: inline-block;\n  text-align: center;\n  -webkit-text-decoration: none;\n  text-decoration: none;\n}\n\n.ql-tooltip a.ql-action::after {\n  content: 'Edit';\n  font-size: 12px;\n}\n\n.ql-tooltip.ql-editing a.ql-action::after {\n  border-right: 0px;\n  content: 'Save';\n  padding-right: 0px;\n}\n\n/* Input should only be shown when we are in edit mode (ie. has .ql-editing) */\n\n.ql-tooltip input[type=text],\n\n.ql-tooltip.ql-editing a.ql-preview,\n.ql-tooltip.ql-editing a.ql-preview,\n\n.ql-tooltip.ql-editing a.ql-remove {\n  display: none;\n}\n\n.quill-hide-toolbar {\n  display: none;\n}\n"},833795(e,t,r){r.d(t,{GE:()=>l,KQ:()=>s,QH:()=>a,Sw:()=>i,_J:()=>n,ky:()=>o,lx:()=>d,qh:()=>c});let n="loading_content--shimmerAnimation--4QUT9",i="loading_content--shimmerOnMenuAnimation--SC39T loading_content--shimmerAnimation--4QUT9",a="loading_content--lightShimmerAnimation--wTz0s",s="loading_content--loadingText--KUZqV",o="loading_content--loadingTextOnMenu--vN9jw loading_content--loadingText--KUZqV",l="loading_content--loadingImage--K5Xvr",d="loading_content--loadingPrimary--vTKi7",c="loading_content--fileLoadUiPlaceholder--K6qgB"},514631(e,t,r){r.d(t,{$g:()=>a,F:()=>u,K_:()=>m,Mn:()=>l,OZ:()=>d,PG:()=>i,Pu:()=>s,WL:()=>g,h:()=>_,q5:()=>o,sl:()=>p,uz:()=>h,yM:()=>c,z